# Ortam değişkenleri örneği.
# Bu dosyayı `.env` olarak kopyalayın ve gerçek değerleri girin:
#   cp .env.example .env
#
# GitHub Actions'ta bu değişkenleri repo secrets olarak tanımlamanız gerekir;
# workflow ortam değişkenlerini kendisi inject eder, .env dosyası repoya
# ASLA commit edilmemelidir (.gitignore'da zaten dışlanıyor).

# Google AI Studio'dan alınır: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kullanılacak Gemini modeli (isteğe bağlı). Boş bırakılırsa gemini-3.8-flash.
# Gemini 3.x serisinden bir GA model adı olmalıdır.
GEMINI_MODEL=

# Gmail gönderici adresi
GMAIL_ADDRESS=

# Gmail Uygulama Şifresi (16 karakter, boşluksuz).
# Oluşturma: https://myaccount.google.com/apppasswords
# NOT: Hesap 2 Adımlı Doğrulama'yı aktif etmiş olmalıdır.
GMAIL_APP_PASSWORD=

# Bültenin gönderileceği alıcı adresi
RECIPIENT_EMAIL=